# LLM (OpenAI-compatible)
# 127.0.0.1:11435 is an SSH port-forward to the remote Ollama (192.168.85.248:11434).
# See scripts/ollama-tunnel.sh. If the remote Ollama runs with OLLAMA_HOST=0.0.0.0,
# you can use http://192.168.85.248:11434/v1 directly instead.
LLM_BASE_URL=http://127.0.0.1:11435/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3-coder

# Agent
MAX_AGENT_ITERATIONS=30

# Server
PORT=8080
# Bearer token for the HTTP API. If unset, a random token is generated at
# startup and printed to the console.
# LOCAL_CODEX_TOKEN=

# Shell
SHELL_DEFAULT_TIMEOUT=120
